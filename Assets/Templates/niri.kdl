// Generated by BW77-Shell. Include from config.kdl with:
//   include "~/.config/niri/bw77.kdl"
//
// Border width and colours come from Control Center > Windows. If you would
// rather manage borders yourself, turn that page off and this file is not
// written.
layout {
    focus-ring {
        width {{borderWidth}}
        active-gradient from="{{borderActiveFrom}}" to="{{borderActiveTo}}" angle={{borderAngle}}
        inactive-color "{{borderInactive}}"
    }

    border {
        width {{borderWidth}}
        active-gradient from="{{borderActiveFrom}}" to="{{borderActiveTo}}" angle={{borderAngle}}
        inactive-color "{{borderInactive}}"
        urgent-color "{{borderUrgent}}"
    }

    insert-hint {
        color "{{accentGlow}}"
    }

    tab-indicator {
        active-color "{{borderActiveFrom}}"
        inactive-color "{{borderInactive}}"
    }
}

overview {
    backdrop-color "{{bgDeep}}"
}

// Draws the shell's wallpaper surface inside the overview backdrop instead of
// leaving it flat. Without this rule niri has no way to know that our
// background layer surface is a wallpaper rather than ordinary shell chrome,
// so the overview falls back to backdrop-color.
//
// The pattern is left unanchored on purpose. A compositor may see a namespace
// that is not byte-for-byte what the shell requested, and an anchored `$` then
// silently matches nothing - which looks exactly like the feature not working.
// Check what niri actually sees with:
//   niri msg --json layers
// Only the dedicated backdrop surface is matched. The main wallpaper surface
// is deliberately left out: place-within-backdrop removes a surface from the
// workspace view, so matching it would empty the workspace thumbnails.
layer-rule {
    match namespace="^bw77-backdrop"
    place-within-backdrop true
}
