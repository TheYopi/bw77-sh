# bw77 - generated from the shell palette. Edits are overwritten.
#
# Micro colourschemes are a flat list of `color-link <group> "<fg>,<bg>"`. Either
# side may be omitted, and a bare colour means foreground only. The `-tc` naming
# convention marks a scheme as truecolour; this one uses hex throughout, so it
# needs a terminal advertising 24-bit colour and micro's `truecolor` option on.
#
# Syntax groups are mapped onto the palette by the job the colour does in the
# shell rather than by hue. The accent carries identifiers because it is the
# colour the shell uses for "the thing you are working with"; danger carries
# errors and statements for the same reason it carries destructive actions.

# The editing surface itself. bgBase rather than bgDeep: bgDeep is the shell's
# backdrop colour, meant to sit behind panels, and a full screen of it reads as
# a hole rather than as a document.
color-link default "{{text}},{{bgBase}}"

# Comments in the muted grey the shell uses for text that is present but not
# being read. Deliberately low contrast - a comment competing with code is the
# usual failure of a generated scheme.
color-link comment "{{textMuted}}"

# Identifiers, types and functions.
color-link identifier "{{accent}}"
color-link identifier.class "{{accentGlow}}"
color-link identifier.var "{{text}}"
color-link type "{{accentGlow}}"
color-link type.keyword "{{magenta}}"

# Keywords and control flow.
color-link statement "{{magenta}}"
color-link preproc "{{gold}}"
color-link special "{{warn}}"
color-link symbol "{{textDim}}"
color-link symbol.brackets "{{textDim}}"
color-link symbol.tag "{{accent}}"

# Literals.
color-link constant "{{gold}}"
color-link constant.number "{{gold}}"
color-link constant.string "{{success}}"
color-link constant.string.char "{{success}}"
color-link constant.bool "{{warn}}"

# Diagnostics.
color-link error "bold {{textDanger}},{{bgActive}}"
color-link todo "bold {{warn}}"
color-link underlined "{{accent}}"

# --- chrome
#
# The status line and tab bar are the editor's own furniture, so they take the
# shell's raised surface and its accent - the same relationship the bar has to
# the desktop.
color-link statusline "{{onSurface}},{{bgRaised}}"
color-link statusline.inactive "{{textMuted}},{{bgRaised}}"
color-link tabbar "{{textDim}},{{bgRaised}}"
color-link tabbar.active "{{onAccent}},{{accent}}"

color-link divider "{{border}},{{bgBase}}"
color-link line-number "{{textMuted}},{{bgBase}}"
color-link current-line-number "{{accent}},{{bgHover}}"
color-link indent-char "{{border}}"

# The cursor line and the column guide are the same tone: both mark position
# rather than content, and giving them different colours implies a distinction
# that is not there.
color-link cursor-line "{{bgHover}}"
color-link color-column "{{bgHover}}"

color-link selection "{{textOnAccent}},{{accent}}"

color-link gutter-error "{{danger}}"
color-link gutter-warning "{{warn}}"

# Micro draws diff markers in the gutter from these.
color-link diff-added "{{success}}"
color-link diff-modified "{{warn}}"
color-link diff-deleted "{{danger}}"

# `ignore` must resolve to the terminal default or micro paints unstyled regions
# with the last colour it used.
color-link ignore "default"

# --- message and prompt lines
color-link message "{{accent}},{{bgRaised}}"
color-link error-message "{{onDanger}},{{danger}}"
color-link hlsearch "{{textOnAccent}},{{warn}}"
color-link match-brace "{{onAccentGlow}},{{accentGlow}}"
